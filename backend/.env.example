# Exemplo de variáveis de ambiente do backend.
# Copie para .env (cp .env.example .env) e troque os valores de exemplo.
# Este arquivo vai para o Git; o .env de verdade, não.

# Conexão com o PostgreSQL (docker compose up -d na raiz do projeto)
DATABASE_URL=postgresql://contratos:contratos@localhost:5432/contratos

# Segredo que assina o JWT da sessão. Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo

# Chave da API do Gemini (usada só pelo backend, nunca vai para o navegador)
GEMINI_API_KEY=sua-chave-aqui

# Primeiro usuário criado pelo seed (npm run seed)
SEED_USUARIO=admin
SEED_SENHA=troque-por-uma-senha

# Pasta temporária dos uploads (apagada após cada requisição)
UPLOAD_TMP_DIR=tmp/uploads

# Pasta onde os PDFs dos contratos ficam guardados
STORAGE_DIR=storage/contratos

# Porta em que a API sobe
PORT=3000

# Ambiente de execução (development, test ou production)
NODE_ENV=development
