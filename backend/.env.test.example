# Exemplo de variáveis de ambiente usadas pelos testes do backend.
# Copie para .env.test (cp .env.test.example .env.test) e troque os valores de exemplo.
# Este arquivo vai para o Git; o .env.test de verdade, não.

# Os testes usam um banco separado, para nunca apagar dados de desenvolvimento
DATABASE_URL=postgresql://contratos:contratos@localhost:5432/contratos_test

# Segredo do JWT nos testes (pode ser diferente do de desenvolvimento)
JWT_SECRET=troque-por-um-segredo-longo-de-teste

# Os testes não chamam a API real do Gemini; o valor pode ser fictício
GEMINI_API_KEY=sua-chave-aqui

# Usuário criado pelo seed nos testes
SEED_USUARIO=admin
SEED_SENHA=troque-por-uma-senha-de-teste

# Mesmas pastas do desenvolvimento, usadas pelos testes de upload
UPLOAD_TMP_DIR=tmp/uploads
STORAGE_DIR=storage/contratos

# Porta em que a API sobe durante os testes
PORT=3000

# Ambiente de execução dos testes
NODE_ENV=test
